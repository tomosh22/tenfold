# Downloads the pinned clangd release for a platform, verifies its SHA-256 and lays it out in a staging directory
# exactly as the package (and the editor's discovery) expects:
#
#   <DEST>/bin/clangd[.exe]
#   <DEST>/lib/clang/<major>/include/...     (builtin headers; clangd finds them at ../lib/clang relative to itself)
#   <DEST>/licenses/LLVM-LICENSE.TXT         (when the asset ships it)
#
# Usage:
#   cmake -DDEST=<staging dir> [-DPLATFORM=linux|windows|mac] [-DCACHE_DIR=<dir>] -P tools/package/FetchClangd.cmake
# PLATFORM defaults to the host. CACHE_DIR (default <DEST>/../clangd-cache) keeps the downloaded zip between runs.
cmake_minimum_required(VERSION 3.20)
get_filename_component(_tf_here "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
include("${_tf_here}/ClangdPin.cmake")

if(NOT DEST)
  message(FATAL_ERROR "FetchClangd: -DDEST=<staging dir> is required")
endif()
if(NOT PLATFORM)
  if(CMAKE_HOST_WIN32)
    set(PLATFORM windows)
  elseif(CMAKE_HOST_APPLE)
    set(PLATFORM mac)
  else()
    set(PLATFORM linux)
  endif()
endif()
if(NOT PLATFORM MATCHES "^(linux|windows|mac)$")
  message(FATAL_ERROR "FetchClangd: PLATFORM must be linux, windows or mac (got '${PLATFORM}')")
endif()
set(_tf_hash "${TENFOLD_CLANGD_SHA256_${PLATFORM}}")
if(NOT _tf_hash OR _tf_hash MATCHES "PLACEHOLDER")
  message(FATAL_ERROR "FetchClangd: no verified SHA-256 pinned for '${PLATFORM}' (tools/package/ClangdPin.cmake)")
endif()
if(NOT CACHE_DIR)
  get_filename_component(CACHE_DIR "${DEST}/../clangd-cache" ABSOLUTE)
endif()

set(_tf_name "clangd-${PLATFORM}-${TENFOLD_CLANGD_VERSION}.zip")
set(_tf_zip "${CACHE_DIR}/${_tf_name}")
set(_tf_url "${TENFOLD_CLANGD_URL_BASE}/${TENFOLD_CLANGD_VERSION}/${_tf_name}")
file(MAKE_DIRECTORY "${CACHE_DIR}")

set(_tf_have FALSE)
if(EXISTS "${_tf_zip}")
  file(SHA256 "${_tf_zip}" _tf_actual)
  if(_tf_actual STREQUAL _tf_hash)
    set(_tf_have TRUE)
    message(STATUS "clangd: using cached ${_tf_zip}")
  else()
    file(REMOVE "${_tf_zip}")
  endif()
endif()
if(NOT _tf_have)
  message(STATUS "clangd: downloading ${_tf_url}")
  file(DOWNLOAD "${_tf_url}" "${_tf_zip}" EXPECTED_HASH SHA256=${_tf_hash} SHOW_PROGRESS TLS_VERIFY ON STATUS _tf_status)
  list(GET _tf_status 0 _tf_code)
  if(NOT _tf_code EQUAL 0)
    file(REMOVE "${_tf_zip}")
    message(FATAL_ERROR "FetchClangd: download failed (${_tf_status}) or SHA-256 mismatch for ${_tf_url}")
  endif()
endif()
message(STATUS "clangd: SHA-256 verified (${_tf_hash})")

set(_tf_tmp "${CACHE_DIR}/extract-${PLATFORM}")
file(REMOVE_RECURSE "${_tf_tmp}")
file(MAKE_DIRECTORY "${_tf_tmp}")
file(ARCHIVE_EXTRACT INPUT "${_tf_zip}" DESTINATION "${_tf_tmp}")

# The zip holds a single top-level directory clangd_<version>/ with bin/ and lib/clang/<major>/include.
set(_tf_root "${_tf_tmp}/clangd_${TENFOLD_CLANGD_VERSION}")
if(PLATFORM STREQUAL "windows")
  set(_tf_exe "clangd.exe")
else()
  set(_tf_exe "clangd")
endif()
if(NOT EXISTS "${_tf_root}/bin/${_tf_exe}" OR NOT IS_DIRECTORY "${_tf_root}/lib/clang")
  message(FATAL_ERROR "FetchClangd: unexpected archive layout under ${_tf_root}")
endif()

file(REMOVE_RECURSE "${DEST}")
file(MAKE_DIRECTORY "${DEST}/bin" "${DEST}/lib" "${DEST}/licenses")
file(COPY "${_tf_root}/bin/${_tf_exe}" DESTINATION "${DEST}/bin"
     FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
file(COPY "${_tf_root}/lib/clang" DESTINATION "${DEST}/lib")
if(EXISTS "${_tf_root}/LICENSE.TXT")
  file(COPY_FILE "${_tf_root}/LICENSE.TXT" "${DEST}/licenses/LLVM-LICENSE.TXT")
endif()
file(WRITE "${DEST}/clangd-version.txt" "${TENFOLD_CLANGD_VERSION}\n")
file(REMOVE_RECURSE "${_tf_tmp}")
message(STATUS "clangd ${TENFOLD_CLANGD_VERSION} (${PLATFORM}) staged in ${DEST}")
